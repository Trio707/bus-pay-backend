# Local PostgreSQL 18
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/buspay?schema=public"
PORT=3000
JWT_SECRET=change-me

OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=

# --- Beem SMS (Tanzanian networks) ---
# SMS_PROVIDER=mock | beem | swala
# mock: no real SMS. beem: Beem keys below. swala: SWALA_* below.
SMS_PROVIDER=mock
SMS_DISPATCH_ENABLED=true
SMS_DISPATCH_INTERVAL_MS=10000

# --- Beem Africa (https://docs.beem.africa) ---
# Basic auth: API key + secret key. Sender ID is the approved source address.
# Legacy names BEEM_SMS_API_KEY, BEEM_SMS_SECRET_KEY, and BEEM_SMS_SENDER_NAME still work.
BEEM_API_KEY=
BEEM_SECRET_KEY=
BEEM_SENDER_ID=
BEEM_SMS_BASE_URL=https://apisms.beem.africa/v1

# --- SwalaSMS (https://swalasms.com/sms/developer/docs) ---
# Put the real API key and approved sender ID in .env only. Never commit them.
SWALA_API_KEY=
SWALA_SENDER_ID=
# Signing secret shown once when the webhook endpoint is created in the SwalaSMS dashboard.
SWALA_WEBHOOK_SECRET=
SWALA_API_BASE_URL=https://swalasms.com/api/v1

# External financial rail. NFC fares stay on the BusPay ledger.
# PAYOUT_PROVIDER=mock does not send money.
# PAYOUT_PROVIDER=selcom is refused until an official Selcom adapter exists.
# Credential names will be added from Selcom's official documentation.
# Do not commit credentials.
# PAYOUT_PROVIDER=mock
PAYOUT_MOBILE_PROVIDERS=
PAYOUT_BANK_PROVIDERS=
PAYOUT_WEBHOOK_SECRET=

# Direct passenger wallet funding. NFC fares do not use this rail.
# DEPOSIT_PROVIDER=mock accepts sandbox callbacks only. It does not collect money.
# DEPOSIT_PROVIDER=selcom is refused until official Selcom documentation exists.
# DEPOSIT_WEBHOOK_SECRET signs sandbox callbacks. It is not a Selcom signature.
# Do not commit credentials.
DEPOSIT_PROVIDER=mock
DEPOSIT_WEBHOOK_SECRET=

# Company distributions are not sent to a bank until an official provider exists.
# COMPANY_FINANCE_WEBHOOK_SECRET signs sandbox completion callbacks only.
# Do not commit credentials.
COMPANY_FINANCE_WEBHOOK_SECRET=

# Local folder for conductor/wakala profile photos. Not committed.
PROFILE_PHOTO_DIR=uploads/profile-photos

# Master Wakala onboarding email. Put the real API key in .env only. Never commit it.
# RESEND_FROM_EMAIL is the sender Resend has already allowed. It is not hard-coded.
# BUSPAY_CONTROL_CENTER_URL is the admin login page, for example http://localhost:5173
RESEND_API_KEY=
RESEND_FROM_EMAIL=
BUSPAY_CONTROL_CENTER_URL=
