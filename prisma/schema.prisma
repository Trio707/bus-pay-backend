generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  CONDUCTOR
  AGENT
  MASTER_AGENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum WalletStatus {
  ACTIVE
  FROZEN
  CLOSED
}

enum CardStatus {
  ACTIVE
  FROZEN
  REPLACED
  LOST
  DAMAGED
}

enum MerchantCategory {
  TRANSPORT
  RETAIL
  FERRY
  STADIUM
  EVENT
  PARKING
  OTHER
}

enum MerchantStatus {
  ACTIVE
  INACTIVE
}

enum TerminalType {
  NFC_READER
  POS
  GATE
  APP
}

enum TerminalStatus {
  ACTIVE
  INACTIVE
}

enum ServiceType {
  TRANSPORT
  RETAIL
  FERRY
  STADIUM
  EVENT
  PARKING
  OTHER
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
  REVERSED
}

enum TopUpSource {
  AGENT_TOPUP
  INITIAL_LOAD
  ADMIN_ADJUST
  MOBILE_MONEY
}

enum DepositChannel {
  MOBILE_MONEY
  BANK
}

enum MobileMoneyNetwork {
  MPESA
  AIRTEL_MONEY
  MIXX_BY_YAS
  HALOPESA
  OTHER
}

enum WalletDepositStatus {
  PENDING
  PROCESSING
  UNKNOWN
  COMPLETED
  FAILED
  REVERSED
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
}

enum ConductorPayoutMethod {
  MOBILE_MONEY
  BANK
}

enum ConductorPayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REVERSED
}

enum SettlementStatus {
  DRAFT
  FINALIZED
  PAID
}

enum CardInventoryStatus {
  IN_STOCK
  ISSUED
  DAMAGED
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum AlertStatus {
  OPEN
  ACKED
}

enum RefundStatus {
  COMPLETED
}

enum WakalaFloatTransactionType {
  FLOAT_FUNDING
  PASSENGER_TOPUP
  CONDUCTOR_WITHDRAWAL
  ADJUSTMENT
}

/// How float was funded. ADMIN is the development path.
/// PAYMENT_PROVIDER is reserved for a later verified Selcom/bank callback.
enum WakalaFloatFundingChannel {
  ADMIN
  PAYMENT_PROVIDER
}

model User {
  id                  String     @id @default(uuid())
  username            String     @unique
  passwordHash        String
  firstName           String
  lastName            String
  phone               String     @unique
  nida                String
  mustChangePassword    Boolean    @default(false)
  credentialEmailSentAt DateTime?
  profilePhotoKey       String?
  profilePhotoUpdatedAt DateTime?
  email                 String?
  tillNumber          String?
  role                UserRole
  status              UserStatus @default(ACTIVE)
  sessionVersion      Int        @default(0)
  failedLoginAttempts Int        @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  merchants           Merchant[]
  terminals           Terminal[]
  auditLogs           AuditLog[]
  topUps              TopUp[]              @relation("TopUpAgent")
  withdrawals         Withdrawal[]         @relation("WithdrawalAgent")
  withdrawalsProcessed Withdrawal[]        @relation("WithdrawalProcessor")
  conductorWithdrawals Withdrawal[]        @relation("WithdrawalConductor")
  conductorPayouts    ConductorPayout[]
  wakalaCommission    WakalaCommissionAccount?
  settlementsPaid     Settlement[]         @relation("SettlementPayer")
  refunds             Refund[]
  wakalaFloat         WakalaFloat?
  floatTransactions   WakalaFloatTransaction[]
  companyFinanceRequested CompanyFinanceTransaction[] @relation("CompanyFinanceRequester")
  companyFinanceApproved  CompanyFinanceTransaction[] @relation("CompanyFinanceApprover")
  permissions         UserPermission[]

  @@index([nida])
  @@index([role, nida])
}

model Customer {
  id        String     @id @default(uuid())
  firstName String
  lastName  String
  phone     String     @unique
  nida      String     @unique
  email     String?
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  wallet    Wallet?
}

model Wallet {
  id           String                @id @default(uuid())
  publicCode   String                @unique
  customerId   String                @unique
  customer     Customer              @relation(fields: [customerId], references: [id])
  balance      Int                   @default(0)
  status       WalletStatus          @default(ACTIVE)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  cards        Card[]
  transactions PaymentTransaction[]
  topUps       TopUp[]
  deposits     WalletDeposit[]
}

model Card {
  id           String                @id @default(uuid())
  /// Permanent 12-digit BusPay account number. Historical physical cards share it.
  /// One live card (ACTIVE or FROZEN) per number is enforced by Card_serialNumber_live_key.
  serialNumber String
  nfcUid       String?               @unique
  status       CardStatus            @default(ACTIVE)
  issuedAt     DateTime              @default(now())
  walletId     String
  wallet       Wallet                @relation(fields: [walletId], references: [id])
  replacedById String?               @unique
  replacedBy   Card?                 @relation("CardReplacement", fields: [replacedById], references: [id])
  replaces     Card?                 @relation("CardReplacement")
  transactions PaymentTransaction[]
  topUps       TopUp[]

  @@index([serialNumber])
}

model Merchant {
  id                String                @id @default(uuid())
  merchantCode      String                @unique
  name              String
  category          MerchantCategory
  settlementAccount String?
  ownerUserId       String?
  owner             User?                 @relation(fields: [ownerUserId], references: [id])
  status            MerchantStatus        @default(ACTIVE)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  terminals         Terminal[]
  transactions      PaymentTransaction[]
  settlementLines   SettlementLine[]
}

model Terminal {
  id           String                @id @default(uuid())
  terminalCode String                @unique
  merchantId   String
  merchant     Merchant              @relation(fields: [merchantId], references: [id])
  ownerUserId  String?
  owner        User?                 @relation(fields: [ownerUserId], references: [id])
  type         TerminalType
  status       TerminalStatus        @default(ACTIVE)
  transactions PaymentTransaction[]

  @@index([ownerUserId])
}

model PaymentTransaction {
  id          String            @id @default(uuid())
  reference   String            @unique
  cardId      String
  card        Card              @relation(fields: [cardId], references: [id])
  walletId    String
  wallet      Wallet            @relation(fields: [walletId], references: [id])
  merchantId  String
  merchant    Merchant          @relation(fields: [merchantId], references: [id])
  terminalId  String?
  terminal    Terminal?         @relation(fields: [terminalId], references: [id])
  amount          Int
  /// Conductor share of this fare. Historical rows keep the full amount.
  conductorShare  Int
  /// BusPay fare revenue for this tap. Historical rows are 0.
  platformFee     Int           @default(0)
  currency        String        @default("TZS")
  serviceType     ServiceType
  status      TransactionStatus
  createdAt   DateTime          @default(now())
  refund      Refund?

  @@index([createdAt])
  @@index([walletId, createdAt])
}

model SmsOutbox {
  id                 String    @id @default(uuid())
  phone              String
  message            String
  type               String
  status             String    @default("PENDING")
  provider           String?
  providerMessageId  String?
  providerStatus     String?
  attemptCount       Int       @default(0)
  nextAttemptAt      DateTime?
  deliveryPollCount  Int       @default(0)
  nextDeliveryPollAt DateTime?
  lastError          String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([status, nextAttemptAt])
  @@unique([provider, providerMessageId])
}

model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String
  actor       User     @relation(fields: [actorUserId], references: [id])
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([actorUserId])
}

model TopUp {
  id              String      @id @default(uuid())
  reference       String      @unique
  walletId        String
  wallet          Wallet      @relation(fields: [walletId], references: [id])
  cardId          String?
  card            Card?       @relation(fields: [cardId], references: [id])
  agentUserId     String?
  agent           User?       @relation("TopUpAgent", fields: [agentUserId], references: [id])
  amount          Int
  previousBalance Int
  newBalance      Int
  source          TopUpSource
  createdAt       DateTime    @default(now())

  @@index([createdAt])
  @@index([walletId])
  @@index([agentUserId])
}

model Withdrawal {
  id              String           @id @default(uuid())
  reference       String           @unique
  agentUserId     String
  agent           User             @relation("WithdrawalAgent", fields: [agentUserId], references: [id])
  /** Conductor cash-out via wakala till (null for agent→platform withdrawals). */
  conductorUserId String?
  conductor       User?            @relation("WithdrawalConductor", fields: [conductorUserId], references: [id])
  amount          Int
  platformFee     Int              @default(0)
  /// Cash handed over plus the platform fee reserved from conductor earnings.
  totalDebit      Int
  status          WithdrawalStatus @default(PENDING)
  notes           String?
  requestedAt     DateTime         @default(now())
  processedById   String?
  processedBy     User?            @relation("WithdrawalProcessor", fields: [processedById], references: [id])
  processedAt     DateTime?

  @@index([status, requestedAt])
  @@index([agentUserId])
  @@index([conductorUserId, requestedAt])
}

/// Electronic settlement of conductor earnings. Cash-out stays on Withdrawal.
model ConductorPayout {
  id                 String                 @id @default(uuid())
  reference          String                 @unique
  idempotencyKey     String
  conductorUserId    String
  conductor          User                   @relation(fields: [conductorUserId], references: [id])
  amount             Int
  platformFee        Int                    @default(0)
  /// Disbursement plus platform fee. This is the amount reserved from earnings.
  totalDebit         Int
  method             ConductorPayoutMethod
  provider           String
  destination        String
  accountName        String?
  status             ConductorPayoutStatus  @default(PENDING)
  providerReference  String?                @unique
  failureReason      String?
  requestedAt        DateTime               @default(now())
  processingAt       DateTime?
  completedAt        DateTime?
  failedAt           DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@unique([conductorUserId, idempotencyKey])
  @@index([conductorUserId, requestedAt])
  @@index([status, requestedAt])
}

/// Direct mobile-money load into an existing BusPay wallet. Credited only from a verified callback.
model WalletDeposit {
  id                 String              @id @default(uuid())
  reference          String              @unique
  idempotencyKey     String
  walletId           String
  wallet             Wallet              @relation(fields: [walletId], references: [id])
  walletPublicCode   String
  customerId         String
  amount             Int
  channel            DepositChannel      @default(MOBILE_MONEY)
  mobileMoneyNetwork MobileMoneyNetwork
  provider           String
  status             WalletDepositStatus @default(PENDING)
  providerReference  String              @unique
  customerPhone      String
  failureReason      String?
  topUpId            String?             @unique
  requestedAt        DateTime            @default(now())
  processingAt       DateTime?
  completedAt        DateTime?
  failedAt           DateTime?
  reversedAt         DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([walletId, idempotencyKey])
  @@index([status, requestedAt])
  @@index([walletPublicCode])
  @@index([provider, requestedAt])
}

model Settlement {
  id            String           @id @default(uuid())
  reference     String           @unique
  periodStart   DateTime
  periodEnd     DateTime
  status        SettlementStatus @default(DRAFT)
  grossAmount   Int              @default(0)
  feeAmount     Int              @default(0)
  netAmount     Int              @default(0)
  createdAt     DateTime         @default(now())
  finalizedAt   DateTime?
  paidAt        DateTime?
  paidById      String?
  paidBy        User?            @relation("SettlementPayer", fields: [paidById], references: [id])
  lines         SettlementLine[]

  @@index([createdAt])
  @@index([status])
}

model SettlementLine {
  id                String     @id @default(uuid())
  settlementId      String
  settlement        Settlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  merchantId        String
  merchant          Merchant   @relation(fields: [merchantId], references: [id])
  grossAmount       Int
  feeAmount         Int
  netAmount         Int
  settlementAccount String?

  @@index([settlementId])
  @@index([merchantId])
}

model CardInventory {
  id           String              @id @default(uuid())
  serialNumber String              @unique
  nfcUid       String?             @unique
  status       CardInventoryStatus @default(IN_STOCK)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([status])
}

model Refund {
  id            String            @id @default(uuid())
  reference     String            @unique
  transactionId String            @unique
  transaction   PaymentTransaction @relation(fields: [transactionId], references: [id])
  amount        Int
  reason        String?
  actorUserId   String
  actor         User              @relation(fields: [actorUserId], references: [id])
  status        RefundStatus      @default(COMPLETED)
  createdAt     DateTime          @default(now())

  @@index([createdAt])
}

model Alert {
  id         String        @id @default(uuid())
  type       String
  severity   AlertSeverity @default(INFO)
  message    String
  entityType String?
  entityId   String?
  status     AlertStatus   @default(OPEN)
  createdAt  DateTime      @default(now())
  ackedAt    DateTime?

  @@index([status, createdAt])
  @@index([type])
}

model WakalaFloat {
  id           String                   @id @default(uuid())
  agentUserId  String                   @unique
  agent        User                     @relation(fields: [agentUserId], references: [id])
  balance      Int                      @default(0)
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  transactions WakalaFloatTransaction[]
}

model WakalaFloatTransaction {
  id                String                      @id @default(uuid())
  floatId           String
  float             WakalaFloat                 @relation(fields: [floatId], references: [id])
  agentUserId       String
  agent             User                        @relation(fields: [agentUserId], references: [id])
  type              WakalaFloatTransactionType
  amount            Int
  balanceBefore     Int
  balanceAfter      Int
  reference         String                      @unique
  reason            String?
  fundingChannel    WakalaFloatFundingChannel?
  externalReference String?                     @unique
  topUpId           String?                     @unique
  withdrawalId      String?                     @unique
  createdAt         DateTime                    @default(now())

  @@index([agentUserId, createdAt])
  @@index([floatId, createdAt])
}

model SystemSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

enum FinancialAccountType {
  ASSET
  LIABILITY
  REVENUE
  EXPENSE
  EQUITY
  CLEARING
}

enum FinancialAccountStatus {
  ACTIVE
  FROZEN
}

enum LedgerDirection {
  DEBIT
  CREDIT
}

enum LedgerTransactionStatus {
  POSTED
  REVERSED
}

enum CommissionType {
  REGISTRATION
  TOP_UP
  RENEWAL
  ADJUSTMENT
}

enum CommissionEntryStatus {
  PENDING
  SETTLED
  REVERSED
}

/// Control accounts for BusPay's internal books. Balances are whole TZS.
model FinancialAccount {
  id            String                 @id @default(uuid())
  accountCode   String                 @unique
  name          String
  type          FinancialAccountType
  currency      String                 @default("TZS")
  status        FinancialAccountStatus @default(ACTIVE)
  allowNegative Boolean                @default(false)
  balance       Int                    @default(0)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  entries       FinancialLedgerEntry[]
}

model FinancialLedgerTransaction {
  id                   String                  @id @default(uuid())
  transactionReference String                  @unique
  transactionType      String
  description          String
  status               LedgerTransactionStatus @default(POSTED)
  createdAt            DateTime                @default(now())
  entries              FinancialLedgerEntry[]

  @@index([transactionType, createdAt])
}

model FinancialLedgerEntry {
  id                  String                     @id @default(uuid())
  ledgerTransactionId String
  ledgerTransaction   FinancialLedgerTransaction @relation(fields: [ledgerTransactionId], references: [id])
  accountId           String
  account             FinancialAccount           @relation(fields: [accountId], references: [id])
  direction           LedgerDirection
  amount              Int
  currency            String                     @default("TZS")
  referenceType       String?
  referenceId         String?
  description         String?
  createdAt           DateTime                   @default(now())

  @@index([accountId, createdAt])
  @@index([referenceType, referenceId])
}

/// Configurable fares, fees, and commissions. Missing rows fall back to documented defaults.
model PricingPolicy {
  id        String   @id @default(uuid())
  code      String   @unique
  config    Json
  updatedAt DateTime @updatedAt
}

/// Selcom and SMS costs stay unknown until a contract amount is stored.
model ProviderCost {
  id         String   @id @default(uuid())
  provider   String
  operation  String
  amount     Int?
  configured Boolean  @default(false)
  currency   String   @default("TZS")
  updatedAt  DateTime @updatedAt

  @@unique([provider, operation])
}

model WakalaCommissionAccount {
  id            String                   @id @default(uuid())
  agentUserId   String                   @unique
  agent         User                     @relation(fields: [agentUserId], references: [id])
  balance       Int                      @default(0)
  totalEarned   Int                      @default(0)
  totalPaid     Int                      @default(0)
  lastSettledAt DateTime?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  entries       WakalaCommissionEntry[]
}

model WakalaCommissionSettlement {
  id         String                   @id @default(uuid())
  reference  String                   @unique
  agentUserId String
  amount     Int
  /// Internal batch only. No external payout is sent from this row.
  status     String                   @default("READY")
  createdAt  DateTime                 @default(now())
  entries    WakalaCommissionEntry[]

  @@index([agentUserId, createdAt])
}

model WakalaCommissionEntry {
  id           String                      @id @default(uuid())
  accountId    String
  account      WakalaCommissionAccount     @relation(fields: [accountId], references: [id])
  agentUserId  String
  type         CommissionType
  amount       Int
  status       CommissionEntryStatus       @default(PENDING)
  sourceType   String
  sourceId     String
  settlementId String?
  settlement   WakalaCommissionSettlement? @relation(fields: [settlementId], references: [id])
  createdAt    DateTime                    @default(now())

  @@unique([sourceType, sourceId, type])
  @@index([agentUserId, status])
}

enum CompanyBankAccountStatus {
  ACTIVE
  INACTIVE
  CLOSED
}

enum CompanyFinanceType {
  OWNER_DISTRIBUTION
  COMPANY_EXPENSE
  COMPANY_TRANSFER
  COMPANY_DEPOSIT
  COMPANY_ADJUSTMENT
}

enum CompanyFinanceStatus {
  PENDING
  APPROVED
  PROCESSING
  COMPLETED
  FAILED
  REJECTED
  REVERSED
}

/// A BusPay-owned cash book or bank account. The full account number is not stored.
model CompanyBankAccount {
  id                  String                   @id @default(uuid())
  name                String
  accountType         String
  bankName            String?
  accountNumberMasked String
  ledgerAccountCode   String                   @unique
  currency            String                   @default("TZS")
  status              CompanyBankAccountStatus @default(ACTIVE)
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  transactions        CompanyFinanceTransaction[] @relation("CompanyFinanceBank")
  transferDestinations CompanyFinanceTransaction[] @relation("CompanyFinanceDestination")
}

/// Company-fund movement. Customer wallets, conductor earnings, and Wakala float are not this table.
model CompanyFinanceTransaction {
  id                       String               @id @default(uuid())
  type                     CompanyFinanceType
  amount                   Int
  status                   CompanyFinanceStatus @default(PENDING)
  description              String
  reference                String               @unique
  idempotencyKey           String               @unique
  bankAccountId            String?
  bankAccount              CompanyBankAccount?  @relation("CompanyFinanceBank", fields: [bankAccountId], references: [id])
  destinationBankAccountId String?
  destinationBankAccount   CompanyBankAccount?  @relation("CompanyFinanceDestination", fields: [destinationBankAccountId], references: [id])
  destinationMasked        String?
  expenseAccountCode       String?
  requestedByUserId        String
  requestedBy              User                 @relation("CompanyFinanceRequester", fields: [requestedByUserId], references: [id])
  approvedByUserId         String?
  approvedBy               User?                @relation("CompanyFinanceApprover", fields: [approvedByUserId], references: [id])
  providerReference        String?              @unique
  failureReason            String?
  createdAt                DateTime             @default(now())
  approvedAt               DateTime?
  completedAt              DateTime?
  updatedAt                DateTime             @updatedAt

  @@index([type, createdAt])
  @@index([status, createdAt])
}

model Permission {
  code        String           @id
  group       String
  label       String
  sensitive   Boolean          @default(false)
  assignments UserPermission[]
}

model UserPermission {
  userId         String
  permissionCode String
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission     Permission @relation(fields: [permissionCode], references: [code], onDelete: Cascade)
  createdAt      DateTime   @default(now())

  @@id([userId, permissionCode])
  @@index([permissionCode])
}

/// Remembers a completed financial request so a network retry returns the same result.
model ApiIdempotency {
  id         String   @id @default(uuid())
  scope      String
  key        String
  entityType String
  entityId   String
  createdAt  DateTime @default(now())

  @@unique([scope, key])
  @@index([entityType, entityId])
}
